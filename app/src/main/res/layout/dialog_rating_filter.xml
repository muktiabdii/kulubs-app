<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardPreventCornerOverlap="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Dialog Title -->

        <!-- Rating Options -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/raleway_medium"
            android:gravity="center_horizontal"
            android:text="Filter by Rating"
            android:textColor="#EAA23F"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Rating Options -->
        <LinearLayout
            android:id="@+id/ratingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- Rating 5 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star"
                    android:layout_marginEnd="12dp"
                    android:layout_gravity="center_vertical"
                    app:tint="#FFD700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rating_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5+"
                    android:textSize="16sp"
                    android:fontFamily="@font/raleway_medium"
                    android:textColor="@android:color/black"
                    app:backgroundTint="#FFFFFF"
                    app:strokeColor="#FF5F00"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>

            <!-- Rating 4 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="12dp"
                    app:tint="#FFD700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rating_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4+"
                    android:textSize="16sp"
                    android:fontFamily="@font/raleway_medium"
                    android:textColor="@android:color/black"
                    app:backgroundTint="#FFFFFF"
                    app:strokeColor="#FF780A"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>

            <!-- Rating 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="12dp"
                    app:tint="#FFD700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rating_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3+"
                    android:textSize="16sp"
                    android:fontFamily="@font/raleway_medium"
                    android:textColor="@android:color/black"
                    app:backgroundTint="#FFFFFF"
                    app:strokeColor="#FF780A"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>

            <!-- Rating 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="12dp"
                    app:tint="#FFD700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rating_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2+"
                    android:textSize="16sp"
                    android:fontFamily="@font/raleway_medium"
                    android:textColor="@android:color/black"
                    app:backgroundTint="#FFFFFF"
                    app:strokeColor="#FF780A"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>

            <!-- Rating 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_horizontal"
                android:paddingVertical="8dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_star"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="12dp"
                    app:tint="#FFD700" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rating_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1+"
                    android:textSize="16sp"
                    android:fontFamily="@font/raleway_medium"
                    android:textColor="@android:color/black"
                    app:backgroundTint="#FFFFFF"
                    app:strokeColor="#E76F51"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_horizontal"
            android:layout_marginTop="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Cancel"
                android:textSize="14sp"
                android:textColor="#FF5F00"
                app:cornerRadius="12dp"
                android:layout_marginEnd="20dp"
                app:strokeColor="#FF5F00"
                app:backgroundTint="#FFFF"
                app:strokeWidth="1dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApply"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Apply"
                android:textSize="14sp"
                android:textColor="#FFFFFF"
                app:cornerRadius="12dp"
                app:backgroundTint="#FF5F00"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>