<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_marginBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_item_review">

    <!-- Label: Komentar Anda / Komentar Pengguna Lain -->
    <TextView
        android:id="@+id/tvLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Komentar Anda"
        android:textStyle="bold"
        android:textColor="#FF6600"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"
        android:visibility="gone" />

    <!-- Header User -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_profile_placeholder"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_circle"
            android:contentDescription="Avatar" />

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tvUsername"
                android:text="John Doe"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:text="100 Ulasan"
                android:textColor="#777777"
                android:textSize="12sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Rating:"
        android:textColor="#000000"
        android:textStyle="bold" />

    <RatingBar
        android:id="@+id/ratingBarItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:outlineProvider="paddedBounds"
        android:progressBackgroundTint="#989A9D"
        android:progressTint="#FF5F00"
        android:secondaryProgressTint="#FF5F00"
        android:isIndicator="true"
        android:numStars="5"
        android:stepSize="1" />

    <TextView
        android:id="@+id/tvItemReview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Isi review user akan ditampilkan di sini..."
        android:textColor="#000000"
        android:textSize="14sp"
        android:layout_marginBottom="8dp"/>

    <!-- Tombol Hapus -->
    <TextView
        android:id="@+id/tvDelete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hapus Review"
        android:textColor="#FF3300"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
